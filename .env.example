# Public URL used for canonical links, Open Graph, the sitemap, and invite / reset links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres connection string (local Postgres, Neon, Supabase, RDS…)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
# Set to 1 for hosted databases that require SSL
DATABASE_SSL=0

# Auth.js — generate with: npm run auth:secret
AUTH_SECRET=replace-me-with-a-long-random-string

# Show demo helpers (one-click sample sign-in, "preview session timeout"). Never enable in production.
NEXT_PUBLIC_DEMO=1
# Password the demo buttons use; must match the one the seed script set (SEED_PASSWORD)
NEXT_PUBLIC_DEMO_PASSWORD=omnidesk-demo-2026

# Used by `npm run db:seed` for every sample account
SEED_PASSWORD=omnidesk-demo-2026
SEED_PIN=1234
